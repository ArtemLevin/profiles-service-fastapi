# === Gateway / общие ===
SERVER_NAME=localhost

# === PostgreSQL (общий контейнер) ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=cinema
POSTGRES_PASSWORD=cinema
POSTGRES_DB_AUTH=auth_db
POSTGRES_DB_ADMIN=admin_db
# БД для сервиса профилей создаётся отдельно (profiles_db)
# Удобно вынести отдельную переменную URL:
DATABASE_URL_PROFILES=postgresql+asyncpg://cinema:cinema@db:5432/profiles_db

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === Elasticsearch ===
ELASTIC_HOST=elasticsearch
ELASTIC_PORT=9200

# === ClickHouse (UGC) ===
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# === JWT (должен совпадать с auth_service) ===
JWT_SECRET=supersecretjwt
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRES_MIN=30
REFRESH_TOKEN_EXPIRES_MIN=43200

# === Django Admin (seed суперпользователя) ===
DJANGO_SECRET_KEY=django-secret-key
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=adminpass

# === Profile Service ===
# 32 байта, закодированные в base64 (AES-256-GCM для шифрования телефона)
PROFILES_CRYPTO_KEY_BASE64=BASE64_32_BYTES_KEY_HERE

# pepper для хеширования номера телефона
PHONE_HASH_PEPPER=my_very_secret_pepper
